<div id="scan-card-root" style="display: flex; flex-direction: column; align-items: center; width: 30; height: 18.4; background-color: #141b2a; border-radius: 2.4; border-width: 0.2; border-color: #6b7fa8; padding-top: 1.2; padding-bottom: 1.2; padding-left: 1.2; padding-right: 1.2;">
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 27.6; height: 4.4;">
    <span id="scan-card-title" style="font-size: 3.6; font-weight: bold; color: #7cc0ff; line-height: 1.2; text-align: center;">-</span>
  </div>
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 27.6; height: 4; margin-top: 0.6;">
    <span id="scan-card-measures" style="font-size: 2.8; color: #f3f6fb; line-height: 1.2; text-align: center;">-</span>
  </div>
  <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 0.6; width: 27.6; height: 6.2; margin-top: 0.8;">
    <div id="scan-card-add" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 17; height: 6.2; background-color: #7cc0ff; border-radius: 3.1; border-width: 0.2; border-color: #7cc0ff;">
      <span id="scan-card-add-text" style="font-size: 2.4; font-weight: bold; color: #06101f; line-height: 1.25; text-align: center;">-</span>
    </div>
    <div id="scan-card-close" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 9.5; height: 6.2; background-color: #26324a; border-radius: 3.1; border-width: 0.2; border-color: #6b7fa8;">
      <span id="scan-card-close-text" style="font-size: 2.4; font-weight: bold; color: #f3f6fb; line-height: 1.25; text-align: center;">-</span>
    </div>
  </div>
</div>

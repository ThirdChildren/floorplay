<div id="menu-hint-root" style="display: flex; flex-direction: row; align-items: center; justify-content: center; width: 38; background-color: #141b2a; border-radius: 2.4; border-width: 0.2; border-color: #6b7fa8; padding-top: 1.2; padding-bottom: 1.2; padding-left: 2; padding-right: 2;">

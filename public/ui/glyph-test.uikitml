<div id="glyph-test-root" style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 40; background-color: #141b2a; border-radius: 2.4; border-width: 0.2; border-color: #6b7fa8; padding-top: 1.6; padding-bottom: 1.6; padding-left: 2.4; padding-right: 2.4;">
